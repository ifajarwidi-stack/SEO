{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-daily.schema.json",
  "title": "Jago.com Security Monitoring - security-daily.json",
  "description": "Agregat harian request diblokir WAF per kategori. Lihat docs/jago-security-data-contract.md. Invarian lintas-field (bad_ip <= jumlah blocked, tanggal berurutan tanpa celah, minimal 720 hari) divalidasi oleh job, bukan oleh skema ini.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "timezone", "categories", "days"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "timezone": { "const": "Asia/Jakarta" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "blocked", "bad_ip", "complete"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "blocked": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "bad_ip": { "type": "integer", "minimum": 0 },
          "complete": { "type": "boolean" }
        }
      }
    }
  }
}
